<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>Hoshino-Island-Setup</AssemblyName><Version>0.17.0</Version><Company>Takayom1</Company><Product>Hoshino Island Installer</Product>
    <ApplicationIcon>../src/GlassDesk.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="Hoshino.CoreSetup.exe" Condition="'$(PayloadPath)' != ''"/>
    <AssemblyMetadata Include="PayloadSha256" Value="$(PayloadSha256)"/>
    <EmbeddedResource Include="../LICENSING.md" LogicalName="Hoshino.LICENSING.md"/>
    <EmbeddedResource Include="../src/LICENSE.txt" LogicalName="Hoshino.LICENSE.txt"/>
    <EmbeddedResource Include="../LICENSE-HOSHINO-MIT.txt" LogicalName="Hoshino.MIT.txt"/>
    <EmbeddedResource Include="../src/THIRD-PARTY-NOTICES.txt" LogicalName="Hoshino.THIRD-PARTY-NOTICES.txt"/>
    <EmbeddedResource Include="../src/Inno-Setup-LICENSE.txt" LogicalName="Hoshino.INNO.txt"/>
  </ItemGroup>
</Project>
