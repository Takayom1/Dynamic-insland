<Window x:Class="DIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HoshiBar"
        Width="760" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" Focusable="False"
        FontFamily="{DynamicResource HoshinoFontFamily}" Foreground="{DynamicResource HoshinoText}"
        TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <!-- Every view sits where the pill's top edge is; the pill's clip reveals it as the pill grows. -->
        <Style x:Key="IslandView" TargetType="Grid">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <SolidColorBrush x:Key="Orange" Color="#FFF2D17D" />
        <SolidColorBrush x:Key="Green" Color="#FFEAB0CF" />
        <SolidColorBrush x:Key="Cyan" Color="#FF83CFF3" />
        <SolidColorBrush x:Key="Secondary" Color="#FFA59CAC" />
        <SolidColorBrush x:Key="ArtPlaceholder" Color="#FF2B2635" />

        <!-- Text boxes on the To-Do and Notes pages: no chrome, the field behind them draws it. -->
        <Style x:Key="IslandTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource HoshinoText}" />
            <Setter Property="CaretBrush" Value="{DynamicResource HoshinoText}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource HoshinoSecondaryAccent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin, rounded, translucent scroll bar for pages that can outgrow the island. -->
        <Style x:Key="SlimScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="2" Background="{DynamicResource HoshinoBorder}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SlimScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Width="4"
                                       Margin="0,2,-10,2" Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource SlimScrollThumb}" />
                                            </Track.Thumb>
                                        </Track>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root has no background: only the pill and its content are hit-testable, the rest clicks through. -->
    <Grid x:Name="Root" Width="760" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top">
        <!-- Liquid Glass: a live, blurred copy of the screen behind the island, clipped to its shape. -->
        <Canvas x:Name="GlassLayer" IsHitTestVisible="False" Visibility="Collapsed">
            <Image x:Name="GlassImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear">
                <Image.Effect>
                    <BlurEffect Radius="14" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
        </Canvas>

        <!-- Pure vector outer shadow for Chibi Pop (zero shader blur, zero clipping) -->
        <Path x:Name="PillCartoonShadow" Fill="{StaticResource HoshinoCartoonInk}" Visibility="Collapsed" IsHitTestVisible="False">
            <Path.RenderTransform>
                <TranslateTransform X="4.5" Y="4.5" />
            </Path.RenderTransform>
        </Path>

        <!-- Geometry is rebuilt every animation frame (rounded pill, concave notch, or chamfered pixel hull). -->
        <Path x:Name="PillShape" Fill="Black" />
        <!-- Skin-specific interior surface chrome (Aero diagonal glass bands, Pixel 3D bevels/Win98 titlebar/screws/compact LCD, Schale sheen). -->
        <Canvas x:Name="SkinClippedOverlay" IsHitTestVisible="False" />
        <!-- Liquid Glass: soft top highlight; brush is built in code from the Shininess setting. -->
        <Path x:Name="GlassSheen" IsHitTestVisible="False" Visibility="Collapsed" />

        <Path x:Name="NotchTopSeal" Fill="Black" IsHitTestVisible="False" Visibility="Collapsed" />

        <Grid x:Name="ContentLayer">

            <!-- Voice Wake ("Хей Хошино"): Eye of Horus backdrop + Hoshino + 3-color waveform capsule -->
            <Grid x:Name="VoiceFocusView" Style="{StaticResource IslandView}" Width="320" Height="258" Background="Transparent" MouseLeftButtonUp="OnVoiceFocusClick" ToolTip="Нажмите на Хошино, чтобы открыть чат">
                <ContentControl x:Name="VoiceFocusHorusHost" Width="196" Height="196" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" IsHitTestVisible="False" />
                <ContentControl x:Name="VoiceFocusHoshino" Width="154" Height="154" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" IsHitTestVisible="False" />
                <Border x:Name="VoiceWaveCapsule" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="18,0,18,12"
                        CornerRadius="18" Padding="16,7" Background="{DynamicResource HoshinoSurface}"
                        BorderBrush="{DynamicResource HoshinoBorder}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <ContentControl x:Name="VoiceWaveformHost" HorizontalAlignment="Center" />
                        <TextBlock x:Name="VoiceActivityText" Text="Слушаю…" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{DynamicResource HoshinoMuted}" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="250" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Compact Lyrics: clean vector Hoshino on left (zero blurry halo), highlighted words in center, LRC badge on right -->
            <Grid x:Name="LyricsView" Style="{StaticResource IslandView}" Width="420" Height="46" Background="Transparent" Cursor="Hand" ToolTip="Нажмите, чтобы раскрыть островок и отключить текст">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0">
                    <ContentControl x:Name="LyricsHoshinoHost" Width="31" Height="31" IsHitTestVisible="False" />
                    <Border x:Name="CompactLyricArt" Width="28" Height="28" CornerRadius="7" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource ArtPlaceholder}">
                        <TextBlock x:Name="CompactLyricArtFallback" Style="{StaticResource Glyph}" Text="&#xE8D6;"
                                   FontSize="13" Foreground="{StaticResource Secondary}" />
                    </Border>
                </Grid>
                <TextBlock x:Name="CompactLyric" Grid.Column="1" Margin="6,8,10,8" FontSize="14" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" LineHeight="21"
                           TextAlignment="Center" VerticalAlignment="Center" />
                <Border x:Name="CompactLrcBadge" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0"
                        CornerRadius="8" Padding="7,2.5" Background="{DynamicResource HoshinoSecondaryAccent}"
                        BorderBrush="{DynamicResource HoshinoBorder}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                    <TextBlock x:Name="CompactLrcText" Text="LRC" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource HoshinoOnAccent}" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- Abydos Mini-Aquarium (optional idle capsule) -->
            <Grid x:Name="AquariumView" Style="{StaticResource IslandView}" Width="248" Height="44" />

            <!-- Clock (idle): compact Hoshino + tabular clock + diamond ◆ + weather icon & temp -->
            <Grid x:Name="ClockView" Style="{StaticResource IslandView}" Width="168" Height="44">
                <StackPanel x:Name="ClockRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0,18,0">
                    <TextBlock x:Name="ClockText" VerticalAlignment="Center" FontSize="15.5" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular" />
                    <StackPanel x:Name="ClockWeather" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <ContentControl x:Name="ClockDiamondHost" VerticalAlignment="Center" />
                        <Border x:Name="ClockWeatherIcon" Width="20" Height="20" VerticalAlignment="Center" />
                        <TextBlock x:Name="ClockWeatherTemp" FontSize="15.5" FontWeight="SemiBold" Margin="5,0,0,0"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Media (compact): themed art/cassette/vinyl + title + 4-band heterochromatic equalizer -->
            <Grid x:Name="MediaView" Style="{StaticResource IslandView}" Width="336" Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="MediaCompactArtHost" VerticalAlignment="Center">
                    <ContentControl x:Name="MediaArtSmallBackHost" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <Border x:Name="MediaArtSmall" Width="26" Height="26" Margin="10,0,0,0" CornerRadius="6"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{StaticResource ArtPlaceholder}">
                        <TextBlock x:Name="MediaArtSmallFallback" Style="{StaticResource Glyph}" Text="&#xE8D6;"
                                   FontSize="11" Foreground="{StaticResource Secondary}" />
                    </Border>
                    <ContentControl x:Name="MediaArtSmallFrontHost" VerticalAlignment="Center" HorizontalAlignment="Left" />
                </Grid>
                <TextBlock x:Name="MediaTitleSmall" Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center"
                           FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="Equalizer" Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,18,0">
                    <Rectangle Width="3.5" Height="15" RadiusX="1.5" RadiusY="1.5" Margin="1.2,0" Fill="{StaticResource Orange}" />
                    <Rectangle Width="3.5" Height="15" RadiusX="1.5" RadiusY="1.5" Margin="1.2,0" Fill="{StaticResource Green}" />
                    <Rectangle Width="3.5" Height="15" RadiusX="1.5" RadiusY="1.5" Margin="1.2,0" Fill="{StaticResource Green}" />
                    <Rectangle Width="3.5" Height="15" RadiusX="1.5" RadiusY="1.5" Margin="1.2,0" Fill="{StaticResource Cyan}" />
                </StackPanel>
            </Grid>

            <!-- Timer (compact): Focus Diamond + clean tabular countdown -->
            <Grid x:Name="TimerView" Style="{StaticResource IslandView}" Width="216" Height="44">
                <StackPanel x:Name="TimerCompactInner" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="44,0,18,0">
                    <ContentControl x:Name="CompactTimerDiamondHost" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock x:Name="TimerTextSmall" VerticalAlignment="Center"
                               FontSize="15.5" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Grid>

            <!-- Stopwatch (compact) -->
            <Grid x:Name="StopwatchView" Style="{StaticResource IslandView}" Width="216" Height="44">
                <StackPanel x:Name="StopwatchCompactInner" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="44,0,18,0">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;"
                               FontSize="15" Margin="0,0,7,0" Foreground="{StaticResource Cyan}" />
                    <TextBlock x:Name="StopwatchTextSmall" VerticalAlignment="Center"
                               FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"
                               Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Grid>

            <!-- Volume / brightness OSD (matches bottom capsule of all 5 compact design renders) -->
            <Grid x:Name="OsdView" Style="{StaticResource IslandView}" Width="336" Height="44">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="OsdIconHost" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <Border x:Name="OsdTrackBorder" Grid.Column="1" Height="10" Margin="10,0" CornerRadius="5"
                            Background="{DynamicResource HoshinoOsdTrackBrush}" BorderBrush="{DynamicResource HoshinoBorder}"
                            BorderThickness="1" VerticalAlignment="Center" ClipToBounds="True">
                        <Border x:Name="OsdFill" HorizontalAlignment="Left" Width="0" CornerRadius="4"
                                Background="{DynamicResource HoshinoProgressBrush}" />
                    </Border>
                    <TextBlock x:Name="OsdPercent" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="15" FontWeight="Bold" Typography.NumeralAlignment="Tabular" />
                </Grid>
            </Grid>

            <!-- Battery / charging -->
            <Grid x:Name="BatteryView" Style="{StaticResource IslandView}" Width="320" Height="44">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="BatteryBolt" Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="14"
                                   Margin="0,0,8,0" Foreground="{StaticResource Green}" />
                        <TextBlock x:Name="BatteryTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="BatteryPercent" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                        <Grid Width="30" Height="14" VerticalAlignment="Center">
                            <Border Width="27" HorizontalAlignment="Left" BorderBrush="{DynamicResource HoshinoMuted}"
                                    BorderThickness="1.2" CornerRadius="4" />
                            <Border x:Name="BatteryFill" HorizontalAlignment="Left" Margin="2.5,2.5,0,2.5"
                                    Width="11" CornerRadius="2" Background="{StaticResource Green}" />
                            <Border HorizontalAlignment="Right" Width="2" Height="5" CornerRadius="0,1,1,0"
                                    Background="{DynamicResource HoshinoMuted}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Short info alerts -->
            <Grid x:Name="InfoView" Style="{StaticResource IslandView}" Width="340" Height="44">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="InfoGlyph" Style="{StaticResource Glyph}" Text="&#xE772;" FontSize="16" />
                    <TextBlock x:Name="InfoTitle" Grid.Column="1" Margin="10,0" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="InfoDetail" Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                               MaxWidth="190" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>

            <!-- Another app's notification -->
            <Grid x:Name="NotificationView" Style="{StaticResource IslandView}" Width="370" Height="58">
                <Grid Margin="13,0,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="NotifIcon" Width="32" Height="32" CornerRadius="8" VerticalAlignment="Center"
                            Background="{StaticResource ArtPlaceholder}" />
                    <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NotifTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NotifBody" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Secondary}" />
                    </StackPanel>
                    <TextBlock x:Name="NotifApp" Grid.Column="2" FontSize="11" MaxWidth="90" Margin="0,11,0,0"
                               VerticalAlignment="Top" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Secondary}" />
                </Grid>
            </Grid>

            <!-- Timer finished alert -->
            <Grid x:Name="TimerDoneView" Style="{StaticResource IslandView}" Width="320" Height="44">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TimerDoneGlyph" Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="15"
                               Margin="0,0,10,0" Foreground="{StaticResource Orange}" />
                    <TextBlock x:Name="TimerDoneText" Text="Фокус завершён" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- Expanded Bento Island (fixed 620px wide landscape layout matching all 5 design renders) -->
            <Grid x:Name="ExpandedView" Style="{StaticResource IslandView}" Width="620" Background="Transparent">
                <Border x:Name="ArtBanner" VerticalAlignment="Top" Height="160" Opacity="0.55"
                        Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#80000000" Offset="0.5" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                    <MediaElement x:Name="MotionBanner" Stretch="UniformToFill" IsMuted="True" Volume="0"
                                  LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="False"
                                  Visibility="Collapsed" />
                </Border>

                <StackPanel x:Name="ExpandedContent" Margin="18,14,18,16">

                    <!-- Bento Header: Left icon-only capsule track + Right voice wake chip ("● Хей Хошино") + Gear button -->
                    <Grid x:Name="PageNav" MinHeight="34" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border x:Name="PageTabsTrackShadow" Visibility="{DynamicResource HoshinoCartoonShadowVis}"
                                    Background="{StaticResource HoshinoCartoonInk}" CornerRadius="17" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform X="2.5" Y="2.5" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="PageTabsTrack" CornerRadius="17" Padding="4,3"
                                    Background="{DynamicResource HoshinoSurface}"
                                    BorderBrush="{DynamicResource HoshinoBorder}" BorderThickness="1">
                                <WrapPanel x:Name="PageTabs" Orientation="Horizontal" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel x:Name="PrivacyChip" Margin="6,0,4,0" Orientation="Horizontal"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                <Ellipse x:Name="PrivacyChipDot" Width="7" Height="7" VerticalAlignment="Center" />
                                <TextBlock x:Name="PrivacyChipText" FontSize="11" Margin="5,0,0,0" MaxWidth="110"
                                           Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Grid Margin="6,0,8,0" VerticalAlignment="Center">
                                <Border x:Name="VoiceWakeChipShadow" Visibility="{DynamicResource HoshinoCartoonShadowVis}"
                                        Background="{StaticResource HoshinoCartoonInk}" CornerRadius="16" IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="2.6" Y="2.6" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border x:Name="VoiceWakeChip" CornerRadius="16" Padding="11,5" Cursor="Hand"
                                        Background="{DynamicResource HoshinoSurface}"
                                        BorderBrush="{DynamicResource HoshinoBorder}" BorderThickness="1"
                                        MouseLeftButtonUp="OnVoiceWakeChipClick"
                                        MouseRightButtonUp="OnVoiceWakeChipRightClick"
                                        ToolTip="ЛКМ — голосовая команда Хошино · ПКМ — вкл/выкл фразу «Хей Хошино»">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="VoiceWakeDot" Width="7.5" Height="7.5" VerticalAlignment="Center"
                                                 Fill="{DynamicResource HoshinoGold}" />
                                        <TextBlock x:Name="VoiceWakeLabel" Text="Хей Хошино" FontSize="12" FontWeight="SemiBold"
                                                   Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid VerticalAlignment="Center">
                                <Border x:Name="SettingsGearShadow" Visibility="{DynamicResource HoshinoCartoonShadowVis}"
                                        Background="{StaticResource HoshinoCartoonInk}" CornerRadius="16" IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="2.6" Y="2.6" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border x:Name="SettingsGearWrap" Width="32" Height="32" CornerRadius="16"
                                        Background="{DynamicResource HoshinoSurface}"
                                        BorderBrush="{DynamicResource HoshinoBorder}" BorderThickness="1">
                                    <Button x:Name="SettingsGearButton" Style="{StaticResource IconButton}" Width="30" Height="30"
                                            Click="OnSettingsClick" ToolTip="Настройки острова (или ПКМ по острову)">
                                        <Path x:Name="SettingsGearGlyph" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{DynamicResource HoshinoMuted}" StrokeThickness="1.5"
                                              Data="M 8,5 A 3,3 0 1 1 7.99,5 Z M 8,1.5 V 3.2 M 8,12.8 V 14.5 M 1.5,8 H 3.2 M 12.8,8 H 14.5 M 3.4,3.4 L 4.6,4.6 M 11.4,11.4 L 12.6,12.6 M 12.6,3.4 L 11.4,4.6 M 4.6,11.4 L 3.4,12.6" />
                                    </Button>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- One page visible at a time (ClipToBounds enabled only during slide animation so sticker shadows never tear!) -->
                    <Grid x:Name="PageHost" ClipToBounds="False">
                        <ContentControl x:Name="AiPage" />

                        <StackPanel x:Name="HomePage">
                            <!-- Two-Column Wide Bento Grid: Left Companion Card (242px) | Right Player + Tasks Column (*) -->
                            <Grid x:Name="HomeTop" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="242" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Bento Card: wide speech bubble & balanced Hoshino stage (zero text truncation!) -->
                                <Grid x:Name="HomeCompanionOuter" Margin="0,0,12,0">
                                    <Border x:Name="HomeCompanionShadow" Visibility="{DynamicResource HoshinoCartoonShadowVis}"
                                            Background="{StaticResource HoshinoCartoonInk}" CornerRadius="18" IsHitTestVisible="False">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="3.5" Y="3.5" />
                                        </Border.RenderTransform>
                                    </Border>

                                    <Border x:Name="HomeCompanionCard" CornerRadius="18" Padding="11,9,11,9"
                                            Background="{DynamicResource HoshinoCompanionSurface}"
                                            BorderBrush="{DynamicResource HoshinoBorder}" BorderThickness="1">
                                        <Grid>
                                            <Border x:Name="HomeCompanionWell" CornerRadius="0" Padding="0">
                                                <Grid x:Name="HomeCompanionInner">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <ContentControl x:Name="TamagotchiStatusHost" Grid.Row="0" Visibility="Collapsed" />

                                                    <Grid Grid.Row="1" MinHeight="104" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ContentControl x:Name="HomeHorusBackdropHost" Width="122" Height="122"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                        IsHitTestVisible="False" />
                                                        <ContentControl x:Name="HomeHoshinoHost" Width="106" Height="106"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                        IsHitTestVisible="True" />
                                                    </Grid>

                                                    <StackPanel Grid.Row="2" Margin="0,3,0,0">
                                                        <!-- Seamless Chibi Pop upward comic speech-bubble tail -->
                                                        <Canvas x:Name="ComicBubbleTail" Width="18" Height="11" Visibility="Collapsed"
                                                                HorizontalAlignment="Left" Margin="20,0,0,-2.4" Panel.ZIndex="4" IsHitTestVisible="False">
                                                            <Polygon Points="0.5,11.5 8.5,1 16.5,11.5" Fill="{DynamicResource HoshinoControl}" />
                                                            <Path Data="M 0.5,9.2 L 8.5,0.8 L 16.5,9.2"
                                                                  Stroke="{DynamicResource HoshinoBorder}" StrokeThickness="2.2"
                                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        </Canvas>

                                                        <Grid>
                                                            <Border x:Name="HomeMomoShadow" Visibility="{DynamicResource HoshinoCartoonShadowVis}"
                                                                    Background="{StaticResource HoshinoCartoonInk}" CornerRadius="12" IsHitTestVisible="False">
                                                                <Border.RenderTransform>
                                                                    <TranslateTransform X="2.8" Y="2.8" />
                                                                </Border.RenderTransform>
                                                            </Border>

                                                            <Border x:Name="HomeMomoCard" CornerRadius="12" Padding="10,6,10,6" Cursor="Hand"
                                                                    Background="{DynamicResource HoshinoControl}"
                                                                    BorderBrush="{DynamicResource HoshinoBorder}" BorderThickness="1"
                                                                    MouseLeftButtonUp="OnHomePhraseClick"
                                                                    ToolTip="Нажмите, чтобы Хошино сказала следующую реплику">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border x:Name="HomeMomoBar" Width="3.5" CornerRadius="2" Margin="0,1,8,1"
                                                                            Background="{DynamicResource HoshinoMomoBar}" />
                                                                    <TextBlock x:Name="HomePhrase" Grid.Column="1" Text="Ухэ~ Не торопись сегодня"
                                                                               TextWrapping="Wrap" FontSize="11.5" LineHeight="14.5"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="PixelPhraseArrow" Grid.Column="2" Text="▼" FontSize="9"
                                                                               Margin="4,0,0,0" VerticalAlignment="Bottom" Visibility="Collapsed" />
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="HomeCompanionWellBevelBR" BorderThickness="0" IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>

                                    <Border x:Name="HomeCompanionAeroRim" Margin="1" BorderThickness="0" IsHitTestVisible="False" />
                                </Grid>

                                <!-- Right Bento Column: Top Player Card + Bottom Tasks Card -->
                                <StackPanel Grid.Column="1">
                                    <Grid Margin="0,0,0,9">
                                        <Border x:Name="HomePlayerShadow" Visibility="{DynamicResource HoshinoCartoonShadowVis}"
                                                Background="{StaticResource HoshinoCartoonInk}" CornerRadius="18" IsHitTestVisible="False">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="3.5" Y="3.5" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border x:Name="HomePlayerCard" CornerRadius="18" Padding="13,10,13,9"
                                                Background="{DynamicResource HoshinoPlayerSurface}"
                                                BorderBrush="{DynamicResource HoshinoBorder}" BorderThickness="1">
                                            <Grid>
                                                <Grid x:Name="MediaSection">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Upper screen block: Cover on left + (Title, Artist, ProgressBar) on right -->
                                                    <Border x:Name="PlayerScreenBorder" CornerRadius="0" Padding="0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Grid VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                <ContentControl x:Name="MediaArtLargeBackHost" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                <Border x:Name="MediaArtLarge" Width="66" Height="66" CornerRadius="13"
                                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                        Background="{StaticResource ArtPlaceholder}">
                                                                    <TextBlock x:Name="MediaArtLargeFallback" Style="{StaticResource Glyph}" Text="&#xE8D6;"
                                                                               FontSize="22" Foreground="{StaticResource Secondary}" />
                                                                </Border>
                                                                <ContentControl x:Name="MediaArtLargeFrontHost" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                            </Grid>

                                                            <StackPanel Grid.Column="1" Margin="12,0,2,0" VerticalAlignment="Center">
                                                                <StackPanel x:Name="MediaSourceRow" Orientation="Horizontal" Margin="0,0,0,1">
                                                                    <Ellipse x:Name="MediaAppDot" Width="6" Height="6" VerticalAlignment="Center"
                                                                             Fill="{StaticResource Green}" />
                                                                    <TextBlock x:Name="MediaAppName" FontSize="10.5" Margin="5,0,0,0"
                                                                               Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <TextBlock x:Name="MediaTitleLarge" FontSize="14.5" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock x:Name="MediaArtistLarge" FontSize="12" Margin="0,1,0,0"
                                                                           Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />

                                                                <Grid x:Name="ProgressRow" Margin="0,7,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock x:Name="ElapsedText" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                               Foreground="{StaticResource Secondary}" Typography.NumeralAlignment="Tabular"
                                                                               Visibility="Collapsed" />
                                                                    <Grid x:Name="ProgressHit" Grid.Column="1" Height="16" Background="Transparent"
                                                                          MouseLeftButtonUp="OnProgressMouseUp">
                                                                        <Border x:Name="ProgressTrackBorder" Height="7" CornerRadius="3.5"
                                                                                Background="{DynamicResource HoshinoProgressTrackBrush}"
                                                                                BorderBrush="{DynamicResource HoshinoBorder}" BorderThickness="0"
                                                                                VerticalAlignment="Center" ClipToBounds="True">
                                                                            <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="3"
                                                                                    Background="{DynamicResource HoshinoProgressBrush}" />
                                                                        </Border>
                                                                        <Border x:Name="ProgressThumb" Width="11" Height="11" CornerRadius="5.5"
                                                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                                Background="{DynamicResource HoshinoText}"
                                                                                BorderBrush="{DynamicResource HoshinoBorder}" BorderThickness="1.2"
                                                                                IsHitTestVisible="False" />
                                                                    </Grid>
                                                                    <TextBlock x:Name="RemainingText" Grid.Column="2" FontSize="10" Margin="6,0,0,0" HorizontalAlignment="Right"
                                                                               VerticalAlignment="Center" Foreground="{StaticResource Secondary}"
                                                                               Typography.NumeralAlignment="Tabular" Visibility="Collapsed" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Transport & LRC row -->
                                                    <Grid x:Name="MediaControlsRow" Grid.Row="1" Margin="0,6,0,0">
                                                        <StackPanel x:Name="TransportStack" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Width="36" Height="28"
                                                                    Click="OnPreviousClick" ToolTip="Предыдущий трек">
                                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE892;" FontSize="13.5" />
                                                            </Button>
                                                            <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Width="42" Height="30"
                                                                    Margin="8,0" Click="OnPlayPauseClick" ToolTip="Воспроизведение / пауза">
                                                                <TextBlock x:Name="PlayPauseGlyph" Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="17" />
                                                            </Button>
                                                            <Button x:Name="NextButton" Style="{StaticResource IconButton}" Width="36" Height="28"
                                                                    Click="OnNextClick" ToolTip="Следующий трек">
                                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;" FontSize="13.5" />
                                                            </Button>
                                                        </StackPanel>

                                                        <Button x:Name="HomeLyricsToggle" Style="{StaticResource ChipButton}"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Padding="10,4" Margin="0" Content="LRC"
                                                                RenderTransformOrigin="0.5,0.5"
                                                                Click="OnHomeLyricsToggle" ToolTip="Показать синхронную лирику LRC на свёрнутом островке" />
                                                    </Grid>
                                                </Grid>

                                                <StackPanel x:Name="ClockSection" Margin="2,4,2,4">
                                                    <TextBlock x:Name="BigTime" FontSize="30" FontWeight="Light" Typography.NumeralAlignment="Tabular" />
                                                    <TextBlock x:Name="DateText" FontSize="12.5" Margin="0,2,0,0" Foreground="{StaticResource Secondary}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="HomePlayerAeroRim" Margin="1" BorderThickness="0" IsHitTestVisible="False" />
                                    </Grid>

                                    <ContentControl x:Name="HomeTasksHost" />
                                    <ContentControl x:Name="PixelFocusHost" Margin="0,9,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>

                            <ContentControl x:Name="LyricsHost" Visibility="Collapsed" />

                            <ContentControl x:Name="CoworkingHost" Margin="0" />

                            <!-- Integrated Edge-to-Edge Bottom Focus Strip (matches all 5 expanded design renders: 💎 Фокус + 5м / 15м / 25м / 1ч) -->
                            <Border x:Name="FocusDockBorder" CornerRadius="0" Padding="18,8,18,12" Margin="-18,2,-18,-16"
                                    BorderBrush="{DynamicResource HoshinoDivider}" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <Grid x:Name="TimerPresets">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <ContentControl x:Name="FocusDiamondHost" VerticalAlignment="Center" />
                                            <TextBlock x:Name="FocusLabelText" Text="Фокус" FontSize="13.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel x:Name="TimerPresetButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource ChipButton}" Tag="5" Content="5м" Click="OnTimerPresetClick" />
                                            <Button Style="{StaticResource ChipButton}" Tag="15" Content="15м" Click="OnTimerPresetClick" />
                                            <Button Style="{StaticResource ChipButton}" Tag="25" Content="25м" Click="OnTimerPresetClick" />
                                            <Button Style="{StaticResource ChipButton}" Tag="60" Content="1ч" Click="OnTimerPresetClick" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid x:Name="TimerActivePanel">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <ContentControl x:Name="FocusActiveDiamondHost" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TimerTextLarge" FontSize="18" FontWeight="SemiBold" Margin="9,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ChipButton}" Content="+1м" Click="OnTimerAddClick" />
                                            <Button Style="{StaticResource IconButton}" Width="32" Height="28" Margin="6,0,0,0"
                                                    Click="OnTimerPauseClick" ToolTip="Пауза / продолжить">
                                                <TextBlock x:Name="TimerPauseGlyph" Style="{StaticResource Glyph}" Text="&#xE769;" FontSize="13" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="32" Height="28" Margin="2,0,0,0"
                                                    Click="OnTimerCancelClick" ToolTip="Отменить таймер">
                                                <TextBlock x:Name="TimerPauseCancelGlyph" Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Grid x:Name="StopwatchPanel" Margin="0,6,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="15"
                                                       Foreground="{StaticResource Cyan}" />
                                            <TextBlock x:Name="StopwatchTextLarge" FontSize="18" FontWeight="SemiBold" Margin="9,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{StaticResource Cyan}"
                                                       Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Width="32" Height="28" Click="OnStopwatchPauseClick" ToolTip="Пауза / продолжить">
                                                <TextBlock x:Name="StopwatchPauseGlyph" Style="{StaticResource Glyph}" Text="&#xE769;" FontSize="13" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="32" Height="28" Margin="2,0,0,0"
                                                    Click="OnStopwatchResetClick" ToolTip="Сбросить секундомер">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Notifications (Russian) -->
                        <StackPanel x:Name="NotificationsPage">
                            <Grid x:Name="NotificationsToolbar" Margin="0,0,0,6">
                                <TextBlock x:Name="NotificationsCount" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource Secondary}" />
                                <Button Style="{StaticResource ChipButton}" Content="Очистить все" HorizontalAlignment="Right"
                                        Click="OnNotificationsClearClick" ToolTip="Очистить все уведомления" />
                            </Grid>
                            <ScrollViewer x:Name="NotificationsScroller" Style="{StaticResource SlimScroll}" MaxHeight="252">
                                <StackPanel x:Name="NotificationList" />
                            </ScrollViewer>
                            <TextBlock x:Name="NotificationsEmpty" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,6"
                                       HorizontalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource Secondary}" />
                            <Button x:Name="NotificationsSetup" Style="{StaticResource ChipButton}" Content="Настроить доступ…"
                                    HorizontalAlignment="Center" Margin="0,2,0,4" Click="OnIdentitySetupClick" />
                        </StackPanel>

                        <!-- Calendar + Journal (Russian) -->
                        <Grid x:Name="CalendarPage">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock x:Name="CalendarMonthTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource IconButton}" Width="28" Height="24" Click="OnCalendarPrevMonth" ToolTip="Предыдущий месяц">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE76B;" FontSize="11" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="28" Height="24" Click="OnCalendarNextMonth" ToolTip="Следующий месяц">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <UniformGrid x:Name="CalendarWeekdays" Columns="7" />
                                <UniformGrid x:Name="CalendarDays" Columns="7" />
                                <Border Height="1" Background="{DynamicResource HoshinoDivider}" Margin="0,8,0,8" />
                                <ScrollViewer x:Name="CalendarScroller" Style="{StaticResource SlimScroll}" MaxHeight="96">
                                    <StackPanel x:Name="CalendarList" />
                                </ScrollViewer>
                                <TextBlock x:Name="CalendarEmpty" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,6"
                                           HorizontalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource Secondary}" />
                            </StackPanel>
                            <ContentControl x:Name="JournalHost" Grid.Column="2" />
                        </Grid>

                        <!-- To-Do (Russian) -->
                        <StackPanel x:Name="TodoPage" Background="Transparent" MouseLeftButtonUp="OnTypingPageMouseUp">
                            <Border CornerRadius="12" Background="{DynamicResource HoshinoControl}"
                                    BorderBrush="{DynamicResource HoshinoBorder}" BorderThickness="1"
                                    Height="36" Cursor="IBeam" MouseLeftButtonDown="OnTodoFieldMouseDown">
                                <Grid Margin="12,0">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12"
                                               HorizontalAlignment="Left" Foreground="{StaticResource Secondary}" />
                                    <TextBlock x:Name="TodoPlaceholder" Text="Новое дело…" FontSize="13" Margin="24,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{StaticResource Secondary}" />
                                    <TextBox x:Name="TodoInput" Style="{StaticResource IslandTextBox}" Margin="24,0,0,0"
                                             VerticalAlignment="Center" MaxLength="300"
                                             PreviewMouseLeftButtonDown="OnTypingBoxMouseDown"
                                             PreviewKeyDown="OnTodoInputKeyDown" TextChanged="OnTodoInputChanged" />
                                </Grid>
                            </Border>
                            <ScrollViewer x:Name="TodoScroller" Style="{StaticResource SlimScroll}" MaxHeight="200" Margin="0,8,0,0">
                                <StackPanel x:Name="TodoList" />
                            </ScrollViewer>
                            <StackPanel x:Name="TodoEmpty" Margin="0,14,0,10">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="20"
                                           Foreground="{StaticResource Green}" />
                                <TextBlock Text="Все дела выполнены" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Напиши задачу выше и нажми Enter" FontSize="11" Margin="0,2,0,0"
                                           HorizontalAlignment="Center" Foreground="{StaticResource Secondary}" />
                            </StackPanel>
                            <Grid x:Name="TodoFooter" Margin="0,6,0,0">
                                <TextBlock x:Name="TodoCount" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource Secondary}" />
                                <Button x:Name="TodoClearDone" Style="{StaticResource ChipButton}" Content="Очистить выполненные"
                                        HorizontalAlignment="Right" Click="OnTodoClearDoneClick" />
                            </Grid>
                        </StackPanel>

                        <!-- Notes (Russian) -->
                        <StackPanel x:Name="NotesPage" Background="Transparent" MouseLeftButtonUp="OnTypingPageMouseUp">
                            <Border CornerRadius="14" Background="{DynamicResource HoshinoControl}"
                                    BorderBrush="{DynamicResource HoshinoBorder}" BorderThickness="1"
                                    Padding="12,10" Height="168" Cursor="IBeam" MouseLeftButtonDown="OnNoteFieldMouseDown">
                                <Grid>
                                    <TextBlock x:Name="NotePlaceholder" Text="Быстрая заметка…" FontSize="13"
                                               IsHitTestVisible="False" Foreground="{StaticResource Secondary}" />
                                    <TextBox x:Name="NoteBox" Style="{StaticResource IslandTextBox}" AcceptsReturn="True"
                                             AcceptsTab="True" TextWrapping="Wrap" MaxLength="20000"
                                             PreviewMouseLeftButtonDown="OnTypingBoxMouseDown"
                                             PreviewKeyDown="OnNoteKeyDown" TextChanged="OnNoteChanged" />
                                </Grid>
                            </Border>
                            <Grid Margin="0,6,0,0">
                                <TextBlock x:Name="NoteStatus" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{StaticResource Secondary}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource ChipButton}" Content="Копировать" Click="OnNoteCopyClick"
                                            ToolTip="Скопировать заметку в буфер обмена" />
                                    <Button x:Name="NoteClearButton" Style="{StaticResource ChipButton}" Content="Очистить"
                                            Click="OnNoteClearClick" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- File shelf (Russian) -->
                        <Grid x:Name="ShelfPage">
                            <StackPanel>
                                <ContentControl x:Name="ShelfQrHost" />
                                <Grid x:Name="ShelfToolbar" Margin="0,0,0,8">
                                    <TextBlock x:Name="ShelfCount" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource Secondary}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="ShelfQrButton" Style="{StaticResource ChipButton}" Content="На телефон (QR)"
                                                Click="OnShelfQrClick" ToolTip="Передать выбранный файл или всю полку на телефон по Wi-Fi (либо принять файлы с телефона)" />
                                        <Button x:Name="ShelfDragAll" Style="{StaticResource ChipButton}" Content="Перетащить все"
                                                ToolTip="Перетащить все файлы с полки в нужное окно" />
                                        <Button Style="{StaticResource ChipButton}" Content="Очистить" Click="OnShelfClearClick"
                                                ToolTip="Убрать файлы с полки (сами файлы на диске не удаляются)" />
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer x:Name="ShelfScroller" Style="{StaticResource SlimScroll}" MaxHeight="196">
                                    <WrapPanel x:Name="ShelfItems" />
                                </ScrollViewer>
                                <Grid x:Name="ShelfEmpty" Height="128">
                                    <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource HoshinoBorder}" StrokeThickness="1.5"
                                               StrokeDashArray="4 3" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="20"
                                                   Foreground="{StaticResource Secondary}" />
                                        <TextBlock Text="Перетащи файлы сюда" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Брось файлы на островок или прими с телефона по Wi-Fi QR" FontSize="11"
                                                   Margin="0,2,0,6" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Secondary}" />
                                        <Button Style="{StaticResource ChipButton}" Content="На телефон (QR)"
                                                HorizontalAlignment="Center" Click="OnShelfQrClick"
                                                ToolTip="Открыть локальный Wi-Fi QR для приёма фото и файлов с телефона" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <Grid x:Name="ShelfDropOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                                <Rectangle x:Name="ShelfDropRect" RadiusX="14" RadiusY="14" StrokeThickness="2"
                                           StrokeDashArray="4 3" Fill="{DynamicResource HoshinoBackdrop}" Stroke="{DynamicResource HoshinoAccent}" />
                                <TextBlock x:Name="ShelfDropText" Text="Отпусти, чтобы положить на полку" FontSize="13"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <!-- Weather -->
                        <StackPanel x:Name="WeatherPage">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="WeatherNowIcon" Width="50" Height="50" VerticalAlignment="Center" />
                                <TextBlock x:Name="WeatherNowTemp" Grid.Column="1" FontSize="40" FontWeight="Light"
                                           Margin="10,0,14,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="WeatherCondition" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="WeatherDetail" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="WeatherPlaceText" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <UniformGrid x:Name="WeatherHours" Rows="1" Margin="0,14,0,0" />
                            <Border Height="1" Background="{DynamicResource HoshinoDivider}" Margin="0,12,0,8" />
                            <StackPanel x:Name="WeatherDays" />
                            <TextBlock x:Name="WeatherProblemText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{StaticResource Secondary}" Visibility="Collapsed" />
                            <TextBlock x:Name="WeatherAttribution" Text="Данные погоды: Open-Meteo.com" FontSize="10" Margin="0,6,0,0"
                                       HorizontalAlignment="Right" Foreground="{StaticResource Secondary}" Opacity="0.7" />
                        </StackPanel>

                        <!-- Quick-launch apps -->
                        <ScrollViewer x:Name="AppsPage" Style="{StaticResource SlimScroll}" MaxHeight="232">
                            <WrapPanel x:Name="QuickAppsRow" HorizontalAlignment="Center" />
                        </ScrollViewer>
                    </Grid>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="CompactHoshinoHost" Width="31" Height="31" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
        </Grid>

        <!-- Outer skin frame details + open-top Notch / Island contour + Perimeter Focus Timer + Weather Rim -->
        <Canvas x:Name="SkinOuterOverlay" IsHitTestVisible="False" />
        <Path x:Name="IslandRimPath" IsHitTestVisible="False" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />

        <Canvas x:Name="PerimeterTimerLayer" IsHitTestVisible="False">
            <Path x:Name="PerimeterTimerTrack" Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="PerimeterTimerArc" Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Ellipse x:Name="PerimeterTimerDot" Visibility="Collapsed" />
        </Canvas>

        <ContentControl x:Name="WeatherRimHost" IsHitTestVisible="False" />

        <!-- Second activity bubble (~8px gap right of pill; circular timer arc or Tamagotchi mini-keychain) -->
        <Grid x:Name="ActivityBubble" HorizontalAlignment="Left" VerticalAlignment="Top" Width="38" Height="38"
              Visibility="Collapsed" RenderTransformOrigin="0,0.5" Cursor="Hand">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Ellipse x:Name="ActivityBubbleShadow" Visibility="{DynamicResource HoshinoCartoonShadowVis}"
                     Fill="{StaticResource HoshinoCartoonInk}" IsHitTestVisible="False">
                <Ellipse.RenderTransform>
                    <TranslateTransform X="3" Y="3" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <ContentControl x:Name="ActivityBubbleKeychainHost" Visibility="Collapsed" IsHitTestVisible="False" />
            <Ellipse x:Name="ActivityBubbleBack" Fill="{DynamicResource HoshinoBackground}"
                     Stroke="{DynamicResource HoshinoBorder}" StrokeThickness="1.3" />
            <Ellipse x:Name="ActivityBubbleRingTrack" Margin="3.2" Stroke="{DynamicResource HoshinoTrack}"
                     StrokeThickness="2.2" Visibility="Collapsed" />
            <Path x:Name="ActivityBubbleArc" Stroke="{DynamicResource HoshinoGold}" StrokeThickness="2.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
            <Ellipse x:Name="ActivityBubbleArt" Margin="5" Visibility="Collapsed" />
            <TextBlock x:Name="ActivityBubbleGlyph" Style="{StaticResource Glyph}" FontSize="14" Text="&#xE916;" />
            <TextBlock x:Name="ActivityBubbleText" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Visibility="Collapsed" Typography.NumeralAlignment="Tabular" />
        </Grid>

        <!-- Mic / camera privacy dot -->
        <Ellipse x:Name="PrivacyDot" Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top"
                 IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
</Window>
