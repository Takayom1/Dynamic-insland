<Window x:Class="DIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hoshino Island — настройки"
        Width="980" Height="800" MinHeight="480" MinWidth="760" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource HoshinoBackground}" Foreground="{DynamicResource HoshinoText}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource HoshinoText}"/><Setter Property="Margin" Value="0,7"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center" Margin="0,4,16,4"/>
                <Border x:Name="track" Grid.Column="1" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource HoshinoBorder}" VerticalAlignment="Center">
                    <Ellipse x:Name="knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
                </Border></Grid>
                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="{DynamicResource HoshinoAccent}"/><Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="knob" Property="Fill" Value="#25202D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="White"/><Setter TargetName="track" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource HoshinoText}"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="pill" Padding="12,8" CornerRadius="9" Background="{DynamicResource HoshinoControl}" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource HoshinoAccent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="pill" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource HoshinoControl}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#FF48484A" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
    </Window.Resources>

    <DockPanel Background="{DynamicResource HoshinoBackground}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource HoshinoSurface}" Padding="24,18">
            <StackPanel>
                <TextBlock Text="Твой остров" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="Внешний вид, привычки и только нужные виджеты." Foreground="#99FFFFFF" Margin="0,5,0,0" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource HoshinoSurface}" BorderBrush="{DynamicResource HoshinoControl}" BorderThickness="0,1,0,0">
            <Grid Margin="16,10">
                <TextBlock x:Name="CreditText" MaxWidth="420" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Foreground="#80FFFFFF" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ChipButton}" Content="Сбросить островок" Click="OnResetClick" />
                    <Button Style="{StaticResource ChipButton}" Content="Готово" Margin="8,0,0,0" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Padding="24,14" Background="{DynamicResource HoshinoBackground}">
            <DockPanel><TextBlock Text="Настроить" FontSize="13" Opacity=".6" VerticalAlignment="Center" Margin="0,0,16,0"/><ComboBox x:Name="CategorySelector" Width="300" HorizontalAlignment="Left"/></DockPanel>
        </Border>
        <Border Visibility="Collapsed"><ScrollViewer x:Name="NavScroller"><StackPanel x:Name="Nav"/></ScrollViewer></Border>
        <ScrollViewer x:Name="SettingsScroller" Background="Transparent" VerticalScrollBarVisibility="Auto">
            <!-- Sections are generated in code-behind. -->
            <StackPanel x:Name="Sections" Margin="24,0,24,20" />
        </ScrollViewer>
    </DockPanel>
</Window>
