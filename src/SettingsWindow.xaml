<Window x:Class="DIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HoshiBar — Твой остров"
        Width="1040" Height="790" MinHeight="540" MinWidth="820"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource HoshinoText}"
        FontFamily="{DynamicResource HoshinoFontFamily}" FontSize="13">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource HoshinoText}" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,4,16,4" />
                            <Border x:Name="track" Grid.Column="1" Width="40" Height="22"
                                    CornerRadius="{DynamicResource HoshinoButtonCornerRadius}"
                                    Background="{DynamicResource HoshinoControl}"
                                    BorderBrush="{DynamicResource HoshinoChipBorderBrush}"
                                    BorderThickness="{DynamicResource HoshinoChipBorderThickness}"
                                    VerticalAlignment="Center">
                                <Border x:Name="knob" Width="14" Height="14"
                                        CornerRadius="{DynamicResource HoshinoButtonInnerCornerRadius}"
                                        Background="{DynamicResource HoshinoMuted}"
                                        HorizontalAlignment="Left" Margin="3,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource HoshinoAccent}" />
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="knob" Property="Background" Value="{DynamicResource HoshinoOnAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource HoshinoText}" />
            <Setter Property="Margin" Value="0,3,7,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="shadow" Visibility="{DynamicResource HoshinoCartoonShadowVis}"
                                    Background="{StaticResource HoshinoCartoonInk}"
                                    CornerRadius="{DynamicResource HoshinoButtonCornerRadius}"
                                    IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform X="2" Y="2" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="pill" Padding="11,6"
                                    CornerRadius="{DynamicResource HoshinoButtonCornerRadius}"
                                    Background="{DynamicResource HoshinoControl}"
                                    BorderThickness="{DynamicResource HoshinoChipBorderThickness}"
                                    BorderBrush="{DynamicResource HoshinoChipBorderBrush}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource HoshinoAccent}" />
                                <Setter Property="Foreground" Value="{DynamicResource HoshinoOnAccent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Skin-aware Slider (heterochromatic glass, matte cyan-pink, 3D gel, candy stripes, or discrete pixel LCD blocks) -->
        <Style x:Key="SliderRepeatLeft" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="8" CornerRadius="{DynamicResource HoshinoButtonCornerRadius}"
                                Background="{DynamicResource HoshinoProgressBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderRepeatRight" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="8" Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="15" Height="15"
                                CornerRadius="{DynamicResource HoshinoButtonCornerRadius}"
                                Background="{DynamicResource HoshinoAccent}"
                                BorderBrush="{DynamicResource HoshinoChipBorderBrush}"
                                BorderThickness="{DynamicResource HoshinoChipBorderThickness}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="8" VerticalAlignment="Center"
                                    CornerRadius="{DynamicResource HoshinoButtonCornerRadius}"
                                    Background="{DynamicResource HoshinoProgressTrackBrush}"
                                    BorderBrush="{DynamicResource HoshinoBorder}"
                                    BorderThickness="1" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeatLeft}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeatRight}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource HoshinoControl}" />
            <Setter Property="Foreground" Value="{DynamicResource HoshinoText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HoshinoBorder}" />
            <Setter Property="CaretBrush" Value="{DynamicResource HoshinoText}" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowOuterGrid">
        <!-- Outer vector hard offset shadow for Chibi Pop (zero shader blur, zero clipping) -->
        <Border x:Name="WindowCartoonShadow" Background="{StaticResource HoshinoCartoonInk}"
                Visibility="Collapsed" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform X="5" Y="5" />
            </Border.RenderTransform>
        </Border>

        <Border x:Name="RootShell" BorderThickness="1.4" ClipToBounds="True">
            <Grid ClipToBounds="True">
                <!-- Skin-specific ambient background chrome (Aero crystal panes, Schale matte ticks & halftone, Pixel screws) -->
                <Canvas x:Name="BgChromeCanvas" IsHitTestVisible="False" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Custom Draggable Skin-Adaptive Header / Caption Bar -->
                    <Border x:Name="HeaderBar" Grid.Row="0" Background="Transparent"
                            MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                        <Grid>
                            <Border x:Name="TopAccentBar" Height="3" VerticalAlignment="Top" IsHitTestVisible="False" />
                            <DockPanel x:Name="HeaderContent" Margin="18,8,12,6" LastChildFill="True">
                                <StackPanel x:Name="CaptionButtonsHost" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Border x:Name="HeaderBadgeDot" Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0"
                                            Background="{DynamicResource HoshinoAccent}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HeaderTitleText" Text="HoshiBar · Твой остров"
                                               FontSize="12" FontWeight="SemiBold" Opacity="0.88" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Two-Pane Body: Left Sidebar ("Твой остров") + Right Scrollable Cards -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="254" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Navigation Sidebar -->
                        <Border x:Name="SidebarPane" Padding="16,14,14,14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="6,0,4,16">
                                    <TextBlock Text="Твой остров" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="Скины, Хошино и виджеты" FontSize="12"
                                               Foreground="{DynamicResource HoshinoMuted}" Margin="0,4,0,0" />
                                </StackPanel>

                                <ScrollViewer x:Name="NavScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="Nav" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Right Settings Content Pane -->
                        <ScrollViewer x:Name="SettingsScroller" Grid.Column="1" Background="Transparent" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="Sections" Margin="24,16,26,24" />
                        </ScrollViewer>
                    </Grid>

                    <!-- Bottom Action Bar + Resize Grip -->
                    <Border x:Name="FooterBar" Grid.Row="2">
                        <Grid Margin="20,10,16,10">
                            <TextBlock x:Name="CreditText" MaxWidth="460" HorizontalAlignment="Left"
                                       TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource HoshinoMuted}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="ResetButton" Style="{StaticResource ChipButton}" Padding="14,7"
                                        Content="Сбросить островок" Click="OnResetClick" />
                                <Button x:Name="DoneButton" Style="{StaticResource ChipButton}" Padding="18,7"
                                        Content="Готово" Margin="10,0,12,0" Click="OnCloseClick" />
                            </StackPanel>
                            <Thumb x:Name="WindowResizeThumb" Width="16" Height="16"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="-10,-2,-10,-6" Cursor="SizeNWSE" Opacity="0.55"
                                   DragDelta="OnResizeThumbDragDelta" ToolTip="Потяните, чтобы изменить размер окна">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Canvas Width="14" Height="14" Background="Transparent">
                                            <Path Data="M 4,13 L 13,4 M 8,13 L 13,8 M 12,13 L 13,12"
                                                  Stroke="{DynamicResource HoshinoMuted}" StrokeThickness="1.4" />
                                        </Canvas>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
